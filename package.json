{
	"name": "pi-swarm-mcp",
	"version": "1.0.0",
	"description": "Quota-aware agent-swarm MCP server: routes concurrent agent turns across multiple AI provider accounts",
	"type": "module",
	"main": "./dist/mcp-server.js",
	"exports": {
		".": "./dist/mcp-server.js"
	},
	"bin": {
		"pi-swarm": "dist/mcp-server.js",
		"pi-swarm-server": "dist/server.js"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"license": "MIT",
	"author": "mobashirrahman",
	"publishConfig": {
		"access": "public"
	},
	"homepage": "https://github.com/mobashirrahman/pi-swarm#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mobashirrahman/pi-swarm.git"
	},
	"bugs": {
		"url": "https://github.com/mobashirrahman/pi-swarm/issues"
	},
	"keywords": [
		"mcp",
		"model-context-protocol",
		"agents",
		"swarm",
		"llm",
		"opencode",
		"claude-code"
	],
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"test": "vitest",
		"test:run": "vitest run",
		"lint": "tsc --noEmit",
		"build": "esbuild src/mcp-server.ts --bundle --platform=node --format=esm --target=es2023 --banner:js='#!/usr/bin/env node' --outfile=dist/mcp-server.js && esbuild src/server.ts --bundle --platform=node --format=esm --target=es2023 --banner:js='#!/usr/bin/env node' --outfile=dist/server.js && node -e \"const fs=require('node:fs');fs.mkdirSync('dist/data',{recursive:true});fs.copyFileSync('src/data/benchmarks.json','dist/data/benchmarks.json')\" && chmod +x dist/mcp-server.js dist/server.js",
		"prepack": "npm run build",
		"prepublishOnly": "npm run lint && npm run test:run",
		"release:check": "npm run lint && npm run test:run && npm run build && npm pack --dry-run",
		"dev": "tsx src/server.ts",
		"start": "tsx src/server.ts",
		"mcp": "tsx src/mcp-server.ts",
		"mcp:dist": "node dist/mcp-server.js",
		"mcp:demo": "tsx scripts/mcp-client-demo.ts",
		"audit": "tsx scripts/audit-providers.ts --chat",
		"bench": "tsx scripts/bench-scheduler.ts",
		"mcp:verify": "tsx scripts/verify-mcp-config.ts",
		"probe:credentials": "tsx scripts/probe-credentials.ts --env-file ./secrets.env"
	},
	"devDependencies": {
		"@types/node": "^22.20.3",
		"esbuild": "^0.28.2",
		"tsx": "^4.23.12",
		"typescript": "^5.9.3",
		"vitest": "^3.2.4"
	},
	"directories": {
		"doc": "docs",
		"example": "examples",
		"test": "tests"
	},
	"dependencies": {
		"assertion-error": "^2.0.1",
		"cac": "^6.7.14",
		"chai": "^5.3.3",
		"check-error": "^2.1.3",
		"debug": "^4.4.3",
		"deep-eql": "^5.0.2",
		"es-module-lexer": "^1.7.0",
		"estree-walker": "^3.0.3",
		"expect-type": "^1.4.0",
		"fdir": "^6.5.0",
		"fsevents": "^2.3.3",
		"js-tokens": "^9.0.1",
		"loupe": "^3.2.1",
		"magic-string": "^0.30.21",
		"ms": "^2.1.3",
		"nanoid": "^3.3.19",
		"pathe": "^2.0.3",
		"pathval": "^2.0.1",
		"picocolors": "^1.1.1",
		"picomatch": "^4.0.7",
		"postcss": "^8.5.28",
		"rollup": "^4.63.3",
		"siginfo": "^2.0.0",
		"source-map-js": "^1.2.1",
		"stackback": "^0.0.2",
		"std-env": "^3.10.0",
		"strip-literal": "^3.1.0",
		"tinybench": "^2.9.0",
		"tinyexec": "^0.3.2",
		"tinyglobby": "^0.2.17",
		"tinypool": "^1.1.1",
		"tinyrainbow": "^2.0.0",
		"tinyspy": "^4.0.6",
		"undici-types": "^6.21.0",
		"vite": "^7.3.6",
		"vite-node": "^3.2.4",
		"why-is-node-running": "^2.3.0"
	}
}
